---

<section class="relative flex min-h-[90vh] items-center justify-center overflow-hidden bg-zinc-950 text-white">
  <!-- Minimal Background -->
  <div class="absolute inset-0 z-0 hero-gradient-base hero-gradient-animated opacity-75"></div>
  <div class="absolute inset-0 z-0 bg-zinc-950/40"></div>
  
  <div class="relative z-10 container mx-auto px-6 text-center md:px-12">
    
    <!-- Main Heading - Simplified -->
    <h1 class="mx-auto max-w-5xl text-5xl font-bold uppercase leading-tight tracking-tight text-white sm:text-6xl md:text-8xl animate-in slide-in-from-bottom-12 fade-in duration-1000 fill-mode-both delay-300">
      Δύναμη. <span class="text-swiss-orange">Πειθαρχία.</span><br class="hidden md:block" />
      Αποτέλεσμα.
    </h1>

    <!-- Subheading -->
    <p class="mx-auto mt-8 max-w-xl text-lg font-light leading-relaxed text-zinc-400 md:text-xl animate-in slide-in-from-bottom-8 fade-in duration-1000 fill-mode-both delay-500">
      Προσωπική καθοδήγηση για πραγματική αλλαγή.
      <span class="block mt-2 text-zinc-300">Στόχος. Μέτρηση. Πρόοδος.</span>
    </p>

    <!-- CTAs - Minimal -->
    <div class="mt-12 flex flex-col items-center justify-center gap-8 sm:flex-row animate-in slide-in-from-bottom-8 fade-in duration-1000 fill-mode-both delay-700">
      <a
        href="/booking"
        class="group relative min-w-[180px] overflow-hidden bg-white px-8 py-4 text-sm font-bold uppercase tracking-[0.15em] text-black transition-all hover:bg-zinc-200 active:scale-95"
      >
        <span class="relative z-10 flex items-center justify-center gap-2">
          Κλείσε Ραντεβού
        </span>
      </a>
      <a
        href="#programs"
        class="text-sm font-bold uppercase tracking-[0.15em] text-zinc-500 transition-colors hover:text-white underline underline-offset-8 decoration-zinc-800 hover:decoration-white"
      >
        Προγράμματα
      </a>
    </div>
  </div>
</section>
